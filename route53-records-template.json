{
  "Comment": "Criacao de registros Route 53 com politica de roteamento de Failover Ativo-Passivo",
  "Changes": [
    {
      "Action": "UPSERT",
      "ResourceRecordSet": {
        "Name": "app.example.com",
        "Type": "A",
        "SetIdentifier": "Primary-Active-Endpoint",
        "Failover": "PRIMARY",
        "TTL": 60,
        "ResourceRecords": [
          {
            "Value": "PRIMARY_PUBLIC_IP"
          }
        ],
        "HealthCheckId": "HEALTH_CHECK_ID_PLACEHOLDER"
      }
    },
    {
      "Action": "UPSERT",
      "ResourceRecordSet": {
        "Name": "app.example.com",
        "Type": "A",
        "SetIdentifier": "Secondary-Standby-Endpoint",
        "Failover": "SECONDARY",
        "TTL": 60,
        "ResourceRecords": [
          {
            "Value": "SECONDARY_PUBLIC_IP"
          }
        ]
      }
    }
  ]
}
