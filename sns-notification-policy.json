{
  "Version": "2012-10-17",
  "Id": "Route53SNSNotificationPolicy",
  "Statement": [
    {
      "Sid": "AllowCloudWatchAlarmsToPublish",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudwatch.amazonaws.com"
      },
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:*:*:route53-failover-alerts"
    },
    {
      "Sid": "AllowRoute53HealthCheckPublish",
      "Effect": "Allow",
      "Principal": {
        "Service": "route53.amazonaws.com"
      },
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:*:*:route53-failover-alerts"
    }
  ]
}
